def main():
    print("🚀 자동 중계 및 랭킹 동기화 시스템 가동!")
    excel = win32com.client.Dispatch("Excel.Application")
    excel.Visible = True
    excel.WindowState = -4143
    
    wb = None
    try:
        wb = excel.Workbooks.Open(os.path.abspath(EXCEL_FILE_PATH))
        
        extracted_excel_path = extract_ranking_data(excel, wb)
        if extracted_excel_path:
            git_push_elo_repo(extracted_excel_path)

        # ==========================================
        # 1단계: 전 시트 자동 캡처 및 저장 후 즉시 자동 검수
        # ==========================================
        captured_files = {}
        failed_macros = []
        MAX_RETRIES = 7

        for m_name, f_name in MACRO_LIST.items():
            print(f"\n📸 [{m_name}] 캡처 및 자동 검수 중...")
            save_path = os.path.join(BASE_DIR, f_name)
            passed = False

            for attempt in range(1, MAX_RETRIES + 1):
                clear_clipboard()
                # 기존 파일이 남아있다면 혼동 방지를 위해 삭제 후 새로 저장
                if os.path.exists(save_path):
                    try:
                        os.remove(save_path)
                    except Exception:
                        pass

                try:
                    excel.Run(m_name)
                except Exception:
                    pass
                time.sleep(2.0)

                temp_img = ImageGrab.grabclipboard()
                if not temp_img:
                    print(f"   ⏳ 클립보드 비어있음, 재시도 ({attempt}/{MAX_RETRIES})...")
                    time.sleep(2)
                    continue

                # 파일로 저장한 뒤 실제 파일을 열어 정밀 자동 검수 수행
                temp_img = temp_img.convert("RGBA").convert("RGB")
                temp_img.save(save_path, "JPEG", quality=75)

                is_ok, reason = verify_saved_image(save_path)
                if is_ok:
                    print(f"   ✅ 자동 검수 통과! ({f_name} - {reason})")
                    captured_files[m_name] = save_path
                    passed = True
                    break
                else:
                    print(f"   ⚠️ 자동 검수 불합격 [{reason}] -> 재캡처 시도 ({attempt}/{MAX_RETRIES})...")
                    time.sleep(2.5)

            if not passed:
                print(f"   ❌ [{m_name}] {MAX_RETRIES}회 시도 후에도 정상 캡처 실패")
                failed_macros.append(f"{m_name} ({f_name})")

        wb.Save()

        # ==========================================
        # 2단계: 전체 검수 결과 판정 (불량 시 배포 자동 차단)
        # ==========================================
        print("\n" + "="*55)
        print(f"📋 자동 검수 요약: 총 {len(MACRO_LIST)}개 중 {len(captured_files)}개 통과 / {len(failed_macros)}개 실패")
        print("="*55)

        if failed_macros:
            print("🚨 다음 시트의 캡처 오류가 해결되지 않아 깃허브 배포를 자동 중단합니다:")
            for item in failed_macros:
                print(f"   - {item}")
            return

        # ==========================================
        # 3단계: 전 시트 검수 통과 시 자동 업로드 및 깃허브 배포
        # ==========================================
        final_urls = {}
        for m_name, save_path in captured_files.items():
            f_name = os.path.basename(save_path)
            print(f"\n☁️ [{f_name}] ImgBB 업로드 중...")
            url = upload_to_imgbb(save_path)
            if url:
                final_urls[m_name] = url
                print(f"   🔗 주소: {url}")
            time.sleep(1.5)

        if len(final_urls) == len(MACRO_LIST):
            update_html(final_urls)
            git_push_dashboard()
            print("\n🟢 모든 자동 검수 및 깃허브 배포가 완료되었습니다.")
        else:
            print("\n⚠️ 일부 이미지 업로드에 실패하여 HTML 갱신 및 배포를 보류했습니다.")
        
    except Exception as e:
        print(f"❌ 치명적 오류 발생: {e}")

if __name__ == "__main__":
    main()