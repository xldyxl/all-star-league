def clear_clipboard():
    try:
        ctypes.windll.user32.OpenClipboard(None)
        ctypes.windll.user32.EmptyClipboard()
        ctypes.windll.user32.CloseClipboard()
    except Exception as e:
        print(f"⚠️ 클립보드 초기화 실패: {e}")

# 🔍 자동 정밀 이미지 검수 함수 (저장된 파일 직접 검증)
def verify_saved_image(image_path):
    """
    저장된 이미지 파일을 직접 열어 하얀 배경 오류나 부분 렌더링 누락이 있는지 자동 검수합니다.
    반환값: (통과여부 bool, 사유 str)
    """
    if not os.path.exists(image_path):
        return False, "파일이 생성되지 않음"

    # 1) 파일 용량 검사 (정상 표 이미지는 보통 수십 KB 이상, 빈 흰색 이미지는 수 KB 수준)
    file_size = os.path.getsize(image_path)
    if file_size < 5000:
        return False, f"파일 용량 비정상적으로 작음 ({file_size} bytes)"

    try:
        with Image.open(image_path) as img:
            rgb_img = img.convert("RGB")
            w, h = rgb_img.size

            if w < 100 or h < 100:
                return False, f"이미지 해상도 비정상 ({w}x{h})"

            # 2) 전체 픽셀의 표준편차 및 밝기 검사
            full_stat = ImageStat.Stat(rgb_img)
            full_stddev = sum(full_stat.stddev) / len(full_stat.stddev)
            full_mean = sum(full_stat.mean) / len(full_stat.mean)

            if full_stddev < 5.0 or (full_mean > 250 and full_stddev < 10.0):
                return False, f"전체 하얀 배경 감지 (밝기: {full_mean:.1f}, 편차: {full_stddev:.1f})"

            # 3) 순수 흰색 픽셀 비율 계산 (RGB 모두 250 이상인 픽셀 비율)
            pixels = list(rgb_img.getdata())
            total_pixels = len(pixels)
            white_pixels = sum(1 for r, g, b in pixels if r >= 250 and g >= 250 and b >= 250)
            white_ratio = white_pixels / total_pixels

            if white_ratio > 0.97:
                return False, f"흰색 배경 비율 과다 ({white_ratio * 100:.1f}%)"

            # 4) 상·중·하 3등분 영역별 편차 검사 (아래쪽이 잘리거나 하얗게 날아가는 현상 방지)
            thirds = [
                ("상단", rgb_img.crop((0, 0, w, int(h * 0.33)))),
                ("중단", rgb_img.crop((0, int(h * 0.33), w, int(h * 0.66)))),
                ("하단", rgb_img.crop((0, int(h * 0.66), w, h))),
            ]
            blank_sections = 0
            for sec_name, crop_img in thirds:
                sec_stat = ImageStat.Stat(crop_img)
                sec_stddev = sum(sec_stat.stddev) / len(sec_stat.stddev)
                if sec_stddev < 2.5:
                    blank_sections += 1

            # 3개 구역 중 2개 이상이 완전히 비어있으면 캡처 불량으로 간주
            if blank_sections >= 2:
                return False, f"영역 다수 공백 감지 ({blank_sections}/3 구역 비어있음)"

            return True, f"정상 (용량: {file_size // 1024}KB, 흰색비율: {white_ratio * 100:.1f}%)"
    except Exception as e:
        return False, f"이미지 파일 열기 오류: {e}"

# 🔄 ImgBB 업로드 함수
def upload_to_imgbb(image_path, max_retries=3, retry_delay=3):
    url = "https://api.imgbb.com/1/upload"
    for attempt in range(1, max_retries + 1):
        try:
            with open(image_path, "rb") as f:
                res = requests.post(
                    url,
                    data={"key": IMGBB_API_KEY, "image": base64.b64encode(f.read())},
                    timeout=20
                )
                if res.status_code == 200:
                    return res.json()['data']['url']
                else:
                    print(f"⚠️ 이미지 업로드 실패 (상태 코드: {res.status_code}), 재시도 중 ({attempt}/{max_retries})...")
        except requests.exceptions.RequestException as e:
            print(f"⚠️ ImgBB API 통신 오류 ({attempt}/{max_retries}): {e}")
        
        if attempt < max_retries:
            time.sleep(retry_delay)
            
    print("❌ ImgBB 최종 업로드 실패 (최대 재시도 횟수 초과)")
    return None

def update_html(urls):
