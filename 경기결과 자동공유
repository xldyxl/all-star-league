def clear_clipboard():
    try:
        ctypes.windll.user32.OpenClipboard(None)
        ctypes.windll.user32.EmptyClipboard()
        ctypes.windll.user32.CloseClipboard()
    except Exception as e: 
        print(f"⚠️ 클립보드 초기화 실패: {e}")

# ✅ 스마트 렌더링 오류 감지 (이미지 하단 영역의 색상 변화율 검사)
def is_blank_image(img):
    try:
        w, h = img.size
        bottom_crop = img.crop((0, int(h * 0.4), w, h))
        stat = ImageStat.Stat(bottom_crop)
        
        stddev_avg = sum(stat.stddev) / len(stat.stddev)
        
        if stddev_avg < 3.0:
            return True
        return False
    except Exception as e:
        return False

def upload_to_imgbb(image_path):
    url = "https://api.imgbb.com/1/upload"
    try:
        with open(image_path, "rb") as f:
            res = requests.post(url, {"key": IMGBB_API_KEY, "image": base64.b64encode(f.read())})
            if res.status_code == 200:
                return res.json()['data']['url']
            else:
                print(f"⚠️ 이미지 업로드 실패 (상태 코드: {res.status_code})")
    except Exception as e: 
        print(f"⚠️ ImgBB API 통신 오류: {e}")
    return None

def update_html(urls):
    t_path = os.path.join(BASE_DIR, "template.html")
    i_path = os.path.join(BASE_DIR, "index.html")
    
    if not os.path.exists(t_path): 
        print("⚠️ template.html 파일을 찾을 수 없습니다!")
        return

    with open(t_path, "r", encoding="utf-8") as f:
        content = f.read()

    mapping = {
        "{{LINK_1ST}}": "CopyRangeAsImage_1st_U49",
        "{{LINK_2ND}}": "CopyRangeAsImage_2nd_U49",
        "{{LINK_3RD}}": "CopyRangeAsImage_3rd_U49",
        "{{LINK_UCLG}}": "CopyRangeAsImage_UCLGROUP_AO25",
        "{{LINK_UCLT}}": "CopyRangeAsImage_UCLT_CM51",
        "{{LINK_UELT}}": "CopyRangeAsImage_UELT_CM51",
        "{{LINK_UECLT}}": "CopyRangeAsImage_UECLT_CM51",
        "{{LINK_FA1}}": "CopyRangeAsImage_FA1_CM51",
        "{{LINK_FA2}}": "CopyRangeAsImage_FA2_CM51",
        "{{LINK_GB}}": "CopyRangeAsImage_GOLDENBOOT_HF120",
        "{{LINK_PM}}": "CopyRangeAsImage_PLAYMAKER_HF120",
    }
    
    for tag, m_name in mapping.items():
        content = content.replace(tag, urls.get(m_name, ""))

    with open(i_path, "w", encoding="utf-8") as f:
        f.write(content)
    print("🌐 index.html 갱신 완료!")

# 🔄 깃허브 자동 업로드 부분 (대시보드 + 랭킹 엑셀 동시 처리)
def git_push():
    print("🚚 GitHub 전송 중 (대시보드 HTML 및 랭킹 엑셀 파일 동시 업로드)...")
    try:
        # 1. BASE_DIR 내의 index.html, Ranking_Data.xlsx 등 변경된 모든 파일 추가
        subprocess.run(["git", "add", "."], check=True, cwd=BASE_DIR)
        
        # 2. 커밋 메시지에 대시보드와 랭킹 데이터가 함께 업데이트됨을 명시
        msg = f"Update: Dashboard & Ranking Data ({time.strftime('%H:%M:%S')})"
        subprocess.run(["git", "commit", "--allow-empty", "-m", msg], check=True, cwd=BASE_DIR)
        
        # 3. 깃허브로 푸시
        subprocess.run(["git", "push", "origin", "main"], check=True, cwd=BASE_DIR)
        print("🚀 GitHub 업데이트 완료! (Streamlit 웹사이트 랭킹도 곧 갱신됩니다)")
    except Exception as e: 
        print(f"⚠️ GitHub 푸시 중 문제 발생: {e}")

def main():
    print("🚀 [초고속 모드] 자동 중계 및 랭킹 동기화 시스템 가동!")
    excel = win32com.client.Dispatch("Excel.Application")
    excel.Visible = True
    excel.WindowState = -4143
    
    wb = None
    try:
        wb = excel.Workbooks.Open(os.path.abspath(EXCEL_FILE_PATH))
        
        print("📥 새로고침 중 (30초)...")
        wb.RefreshAll()
        time.sleep(30) 
        
        # (만약 All-Star LEAGUE.xlsm 내부 매크로로 Ranking_Data.xlsx를 새로 뽑아내는 작업이 있다면 여기서 실행되도록 하시면 됩니다.)

        final_urls = {}
        for m_name, f_name in MACRO_LIST.items():
            print(f"\n📸 [{m_name}] 캡처 진행 중...")
            save_path = os.path.join(BASE_DIR, f_name)
            final_img = None
            
            MAX_RETRIES = 5
            for attempt in range(1, MAX_RETRIES + 1):
                clear_clipboard()
                
                try:
                    excel.Run(m_name)
                except Exception as e:
                    print(f"   ↳ 매크로 실행 오류: {e}")
                    
                time.sleep(1.8)
                
                temp_img = ImageGrab.grabclipboard()
                
                if temp_img:
                    temp_img = temp_img.convert("RGBA").convert("RGB")
                    
                    if is_blank_image(temp_img):
                        print(f"   ⚠️ 엑셀 렌더링 오류(하단 단색 빈 상자) 감지! 재시도... ({attempt}/{MAX_RETRIES})")
                        time.sleep(2)
                        continue
                    else:
                        final_img = temp_img
                        print("   ✅ 정상 이미지 캡처 성공!")
                        break
                else:
                    print(f"   ⚠️ 클립보드에 이미지 없음! 재시도... ({attempt}/{MAX_RETRIES})")
                    time.sleep(2)
            
            if final_img:
                final_img.save(save_path, "JPEG", quality=70)
                url = upload_to_imgbb(save_path)
                if url:
                    final_urls[m_name] = url
                    print(f"   🔗 주소: {url}")
            else:
                print(f"❌ {m_name} 최종 캡처 실패")
        
        if final_urls:
            update_html(final_urls)
            git_push() # 여기서 대시보드 파일과 랭킹 엑셀이 함께 GitHub로 올라갑니다.
            
        wb.Save()
        print("\n🟢 모든 작업이 완료되었습니다.")
        
    except Exception as e:
        print(f"❌ 치명적 오류 발생: {e}")

if __name__ == "__main__":
