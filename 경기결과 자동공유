def main():
    print("🚀 자동 중계 및 랭킹 동기화 시스템 가동!")
    excel = win32com.client.Dispatch("Excel.Application")
    excel.Visible = True
    excel.WindowState = -4143
    
    wb = None
    try:
        wb = excel.Workbooks.Open(os.path.abspath(EXCEL_FILE_PATH))
        
        print("📥 새로고침 중 (30초)...")
        wb.RefreshAll()
        time.sleep(30) 
        
        # ✅ 랭킹 데이터 추출 후 Streamlit(ELO) 저장소로 푸시
        extracted_excel_path = extract_ranking_data(excel, wb)
        if extracted_excel_path:
            git_push_elo_repo(extracted_excel_path)

        final_urls = {}
        for m_name, f_name in MACRO_LIST.items():
            print(f"\n📸 [{m_name}] 캡처 진행 중...")
            save_path = os.path.join(BASE_DIR, f_name)
            final_img = None
            
            MAX_RETRIES = 5
            for attempt in range(1, MAX_RETRIES + 1):
                clear_clipboard()
                try:
                    excel.Run(m_name)
                except Exception as e:
                    pass
                time.sleep(1.8)
                
                temp_img = ImageGrab.grabclipboard()
                
                if temp_img:
                    temp_img = temp_img.convert("RGBA").convert("RGB")
                    if is_blank_image(temp_img):
                        time.sleep(2)
                        continue
                    else:
                        final_img = temp_img
                        print("   ✅ 정상 이미지 캡처 성공!")
                        break
                else:
                    time.sleep(2)
            
            if final_img:
                final_img.save(save_path, "JPEG", quality=70)
                url = upload_to_imgbb(save_path)
                if url:
                    final_urls[m_name] = url
                    print(f"   🔗 주소: {url}")
            else:
                print(f"❌ {m_name} 최종 캡처 실패")
        
        if final_urls:
            update_html(final_urls)
            # ✅ HTML 대시보드 저장소 푸시
            git_push_dashboard() 
            
        wb.Save()
        print("\n🟢 모든 작업이 완료되었습니다.")
        
    except Exception as e:
        print(f"❌ 치명적 오류 발생: {e}")

if __name__ == "__main__":
    main()