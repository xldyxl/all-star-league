def main():
    print("🚀 [All-Star Super League] 최종 시스템 가동!")
    excel = win32com.client.Dispatch("Excel.Application")
    excel.Visible = True
    excel.DisplayAlerts = False

    try:
        wb = excel.Workbooks.Open(os.path.abspath(EXCEL_FILE_PATH))
        print("📥 구글 시트 새로고침 중 (10초 대기)...")
