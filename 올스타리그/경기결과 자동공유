def main():
    if not os.path.exists(EXCEL_FILE_PATH):
        print("❌ 엑셀 파일을 찾을 수 없습니다.")
        return

    print("🚀 [All-Star Super League] 시스템 가동!")
    excel = win32com.client.Dispatch("Excel.Application")
    excel.Visible = True
    excel.DisplayAlerts = False

    try:
        wb = excel.Workbooks.Open(os.path.abspath(EXCEL_FILE_PATH))
        
        # 🔄 [수정] 구글 시트 새로고침 대기시간 10초로 연장
        print("📥 구글 시트 데이터 동기화 중... (10초 대기)")
        wb.RefreshAll()
        time.sleep(10)
        
        final_urls = {}
        for m_name, f_name in MACRO_LIST.items():
            print(f"📸 {m_name} 진행 중...")
            excel.Run(m_name)
            
            # ⚡ [수정] 클립보드 오류 방지를 위해 대기 시간을 1.0초로 살짝 조정
            time.sleep(1.0)
            
            save_path = os.path.join(BASE_DIR, f_name)
            
            # 🛡️ [수정] 클립보드 재시도 로직 추가 (failed to open clipboard 방어)
            img = None
            for attempt in range(3): # 최대 3번 재시도
                try:
                    img = ImageGrab.grabclipboard()
                    if img: break # 이미지 있으면 루프 탈출
                except:
                    pass
                time.sleep(0.5) # 실패 시 0.5초 쉬고 다시 시도

            if img:
                img.save(save_path, "PNG")
                url = upload_to_imgbb(save_path)
                if url:
                    final_urls[m_name] = url
                    print(f"✅ 완료: {url}")
            else:
                print(f"❌ {m_name} 클립보드 오류 (3회 시도 실패)")

        if final_urls:
            update_html(final_urls)
            git_push()

        print("\n🎉 모든 자동 업데이트 작업이 끝났습니다!")
        wb.Save()

    except Exception as e:
        print(f"❌ 프로세스 중 치명적 오류 발생: {e}")
    finally:
        excel.Quit()

if __name__ == "__main__":
    main()