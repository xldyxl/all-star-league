        time.sleep(10)
        
        final_urls = {}
        for m_name, f_name in MACRO_LIST.items():
            print(f"📸 {m_name} 작업 중...")
            
            clear_clipboard() 
            excel.Run(m_name)
            time.sleep(1.0) 
            
            save_path = os.path.join(BASE_DIR, f_name)
            
            img = None
            for attempt in range(3):
                try:
                    img = ImageGrab.grabclipboard()
                    if img: break
                except:
                    pass
                time.sleep(0.5)

            if img:
                img.save(save_path, "PNG")
                url = upload_to_imgbb(save_path)
                if url:
