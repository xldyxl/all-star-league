def upload_to_imgbb(image_path):
    url = "https://api.imgbb.com/1/upload"
    try:
        with open(image_path, "rb") as file:
            payload = {"key": IMGBB_API_KEY, "image": base64.b64encode(file.read())}
            response = requests.post(url, payload)
            if response.status_code == 200:
                return response.json()['data']['url']
    except Exception as e:
        print(f"❌ {image_path} 업로드 오류: {e}")
    return None

def update_html(urls):
    template_path = os.path.join(BASE_DIR, "template.html")
    index_path = os.path.join(BASE_DIR, "index.html")
    if not os.path.exists(template_path):
        print(f"❌ 에러: {template_path} 파일이 없습니다!")
        return

    with open(template_path, "r", encoding="utf-8") as f:
        content = f.read()

    # 이미지 링크 갈아끼우기
    content = content.replace("{{LINK_1ST}}", urls.get("CopyRangeAsImage_1st_Y19", ""))
    content = content.replace("{{LINK_2ND}}", urls.get("CopyRangeAsImage_2nd_Y19", ""))
    content = content.replace("{{LINK_UCLG}}", urls.get("CopyRangeAsImage_UCLGROUP_AP33", ""))
    content = content.replace("{{LINK_UCLT}}", urls.get("CopyRangeAsImage_UCLT_CM51", ""))
    content = content.replace("{{LINK_UELT}}", urls.get("CopyRangeAsImage_UELT_CM51", ""))
    content = content.replace("{{LINK_FA}}", urls.get("CopyRangeAsImage_FACUP_CM51", ""))
    content = content.replace("{{LINK_GB}}", urls.get("CopyRangeAsImage_GOLDENBOOT_HE127", ""))

    with open(index_path, "w", encoding="utf-8") as f:
        f.write(content)
    print("🌐 index.html 생성 완료!")

def git_push():
    print("🚚 GitHub로 웹사이트 배달 중...")
    try:
        subprocess.run(["git", "add", "."], check=True, cwd=BASE_DIR)
        msg = f"Update: {time.strftime('%Y-%m-%d %H:%M:%S')}"
        subprocess.run(["git", "commit", "-m", msg], check=True, cwd=BASE_DIR)
        subprocess.run(["git", "push", "origin", "main"], check=True, cwd=BASE_DIR)
        print("🚀 GitHub 웹사이트 배포 성공!")
    except Exception as e:
        print(f"❌ Git 오류 (수동 Push 필요): {e}")

def main():
    print("🚀 [All-Star Super League] 시스템 가동!")
    excel = win32com.client.Dispatch("Excel.Application")
    excel.Visible = True
    excel.DisplayAlerts = False
    try:
        wb = excel.Workbooks.Open(os.path.abspath(EXCEL_FILE_PATH))
        print("📥 구글 시트 동기화 중... (10초 대기)")
        wb.RefreshAll()
        time.sleep(10)
        
        final_urls = {}
        for m_name, f_name in MACRO_LIST.items():
            print(f"📸 {m_name} 진행 중...")
            excel.Run(m_name)
            time.sleep(1.0)
            
            save_path = os.path.join(BASE_DIR, f_name)
            img = None
            for _ in range(3): # 클립보드 에러 대비 3회 재시도
                try:
                    img = ImageGrab.grabclipboard()
                    if img: break
                except: pass
                time.sleep(0.5)

            if img:
                img.save(save_path, "PNG")
                url = upload_to_imgbb(save_path)
                if url:
                    final_urls[m_name] = url
                    print(f"✅ 완료: {url}")
        
        if final_urls:
            update_html(final_urls)
            git_push()
        wb.Save()
    except Exception as e:
        print(f"❌ 오류 발생: {e}")
    finally:
        excel.Quit()

if __name__ == "__main__":
    main()